# ENV
.env

# D-0025 / F-0004: shadow data dir that shadowed data/ via a miscomputed root.
# Pipelines resolve data through pipelines/paths.py DATA_DIR. Do not recreate.
pipelines/data/

# D-0049: api/static/ is GENERATED by the Node stage in the Dockerfile, from
# ui/src. Committing it made a second canonical copy of the UI - the defect in
# F-0027 - and keeping it would mean the repository and the image disagree
# about which one is real.
api/static/
